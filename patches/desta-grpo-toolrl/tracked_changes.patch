     load_fsdp_param_and_grad
+
+
+def _resolve_desta_model_path(model_path):
+    """If model_path points to a DeSTA model (model_type=='desta25'), return
+    the underlying LLM model id (e.g. 'DeSTA-ntu/Llama-3.1-8B-Instruct')
+    which AutoConfig/AutoModelForCausalLM can load directly.
+    DeSTA's model.safetensors only contains perception/connector weights;
+    the LLM backbone is loaded from config.llm_model_id."""
+    import json
+    try:
+        config_path = None
+        if os.path.isdir(model_path):
+            candidate = os.path.join(model_path, 'config.json')
+            if os.path.isfile(candidate):
+                config_path = candidate
+        else:
+            from transformers.utils import cached_file
+            config_path = cached_file(model_path, 'config.json',
+                                      _raise_exceptions_for_missing_entries=False,
+                                      _raise_exceptions_for_connection_errors=False)
+        if config_path:
+            with open(config_path, 'r') as f:
+                raw_cfg = json.load(f)
+            if raw_cfg.get('model_type') == 'desta25' and raw_cfg.get('llm_model_id'):
+                llm_id = raw_cfg['llm_model_id']
+                warnings.warn(f'DeSTA model detected — redirecting model load to {llm_id}')
+                return llm_id
+    except Exception:
+        pass
+    return model_path

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MTP2 Audio Manifest Row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "sample_id",
    "source_dataset",
    "split",
    "audio_path",
    "task_type",
    "prompt",
    "answer"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "source_dataset": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "minLength": 1
    },
    "audio_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*://).+"
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "duration_sec": {
      "type": "number",
      "minimum": 0
    },
    "language": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_result_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*://).+"
    },
    "metadata": {
      "type": "object"
    }
  }
}
